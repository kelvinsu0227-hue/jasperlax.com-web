{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {"source":"/assets/:file(.*-[A-Za-z0-9_-]{8}\\.js)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/assets/:file(.*-[A-Za-z0-9_-]{8}\\.css)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.jasperlax.com"
        }
      ],
      "destination": "https://jasperlax.com/:path",
      "permanent": true
    }
  ]
}
